# syntax=docker/dockerfile:1.7
# capsule8 cross-toolchain builder image — Phase 2
#
# Phase 2: ct-ng 1.28 (no backport) → aarch64-centos7-linux-gnu
#         glibc 2.17 + GCC 15.2.0 + kernel 3.10.108 + binutils 2.42 + gdb 16.3
#
# Phase 2 vs Phase 1：
#   - ct-ng 1.28 ships GCC 15 / GDB 16 / glibc 2.17 natively → 0 backport patches
#   - Target ARM64 → no multilib (aarch64 has no 32-bit counterpart)
#   - Dockerfile is ~1/4 the length (no sed/awk gymnastics)
#
# Workflow matches Phase 1 (shares the entrypoint script docker-build-target.sh):
#   docker build --platform=linux/amd64 -t finalfantasyliu/cross-toolbox:phase2 \
#                -f toolchain/Dockerfile.phase2 toolchain/
#   docker run --rm --platform=linux/amd64 \
#       -v /Volumes/capsule8-xtools:/opt/x-tools \
#       -v "$PWD/_logs:/build" \
#       finalfantasyliu/cross-toolbox:phase2 \
#       aarch64-centos7-glibc217-gcc15

FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Apt deps identical to Phase 1 (matching layer hash → reuses Phase 1's cache layer)
RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        bison \
        build-essential \
        bzip2 \
        ca-certificates \
        curl \
        file \
        flex \
        gawk \
        gettext \
        git \
        gperf \
        help2man \
        libncurses-dev \
        libtool \
        libtool-bin \
        m4 \
        make \
        patch \
        perl \
        pkg-config \
        python3 \
        python3-dev \
        rsync \
        sed \
        texinfo \
        unzip \
        wget \
        xz-utils \
        zip \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Non-root build user (ct-ng aborts if root). Same uid/gid as Phase 1 → cache hit
RUN touch /var/mail/ubuntu && chown ubuntu /var/mail/ubuntu && \
    userdel -r ubuntu && \
    groupadd -g 1000 ctuser && \
    useradd -u 1000 -g 1000 -m -s /bin/bash ctuser && \
    mkdir -p /opt/x-tools /opt/ct-ng-1.28 /build && \
    chown -R ctuser:ctuser /opt/x-tools /opt/ct-ng-1.28 /build

COPY --chown=ctuser:ctuser vendor/ct-ng-1.28.0-release.tar.xz /tmp/
COPY --chown=ctuser:ctuser configs/ /configs/

USER ctuser
WORKDIR /tmp

# Build ct-ng 1.28 from source — 0 patches
RUN set -eux; \
    cd /tmp; \
    tar xJf ct-ng-1.28.0-release.tar.xz; \
    cd crosstool-ng-1.28.0; \
    ./configure --prefix=/opt/ct-ng-1.28; \
    make -j"$(nproc)"; \
    make install; \
    cd /tmp; rm -rf crosstool-ng-1.28.0 ct-ng-1.28.0-release.tar.xz; \
    /opt/ct-ng-1.28/bin/ct-ng version | head -1; \
    /opt/ct-ng-1.28/bin/ct-ng list-versions GCC 2>/dev/null | grep "15.2.0" || true; \
    /opt/ct-ng-1.28/bin/ct-ng list-versions GLIBC 2>/dev/null | grep "2.17" || true

USER root
ENV PATH=/opt/ct-ng-1.28/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

COPY --chmod=755 scripts/docker/container/docker-build-target.sh /usr/local/bin/docker-build-target.sh

USER ctuser
WORKDIR /build

ENTRYPOINT ["/usr/local/bin/docker-build-target.sh"]
